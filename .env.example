# --- Providers (Phase 1) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MODEL_REGISTRY_PATH=config/models.yaml
REQUEST_TIMEOUT_S=60

# --- Infrastructure (Phase 2): read by docker compose ---
# POSTGRES_PASSWORD only applies when the volume is first created.
# Changed it later? Run `docker compose down -v` (deletes data) or ALTER USER in psql.
POSTGRES_USER=spend
POSTGRES_PASSWORD=spend_dev_password
POSTGRES_DB=spend
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Persistence and budgets (Phase 2): read by the app ---
# Use 127.0.0.1, not localhost: on Windows "localhost" may resolve to IPv6 ::1 first
DATABASE_URL=postgresql+asyncpg://spend:spend_dev_password@127.0.0.1:5432/spend
REDIS_URL=redis://127.0.0.1:6379/0
BUDGET_WARN_THRESHOLD=0.8

# open = allow requests (and log a warning) if Redis is down; closed = reject with 503
BUDGET_FAIL_MODE=open
RECONCILE_ON_STARTUP=true

# --- Phase 3: routing ---
ROUTING_CONFIG_PATH=config/routing.yaml
ROUTING_PROFILE=dev

# --- Phase 4: quality checks and escalation ---
QUALITY_CONFIG_PATH=config/quality.yaml
# false = no sampling or async verification (synchronous escalation still works)
VERIFY_ENABLED=true
WORKER_CONCURRENCY=4
# Unique per worker process; leave empty for the default <hostname>-<pid>
WORKER_CONSUMER_NAME=

# --- Phase 5: analytics API + dashboard ---
# Seconds an analytics response may be served from cache (0 = no cache)
ANALYTICS_CACHE_TTL_S=30
ANALYTICS_MAX_WINDOW_DAYS=366
# The dashboard reads ONLY from the API at this address
GATEWAY_URL=http://127.0.0.1:8000
